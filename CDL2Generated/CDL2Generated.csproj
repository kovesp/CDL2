<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <!-- Prevent building in Debug and Release configurations -->
  <Target Name="BeforeBuild">
    <Error Condition="'$(Configuration)' != 'DebugGenerated' And '$(Configuration)' != 'ReleaseGenerated'" 
           Text="CDL2Generated project should only be built with DebugGenerated or ReleaseGenerated configuration. Current configuration is: $(Configuration)" />
  </Target>

  <ItemGroup>
    <!-- Include only .cs files from the CDL2 subdirectory -->
    <Compile Include="..\CDL2v1\CDL2\**\*.cs" />
  </ItemGroup>

</Project>