{
  "profiles": {
    "CodeGen": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v3 -d3 --allow-errors\r\n--messages Warning",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Pretty Print": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d3\r\n--pretty-print window --parse-only\r\n--allow-errors --save\r\n",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2\r\n-v5 -d5 --allow-errors --messages Warning\r\n--lab\r\n--console:false\r\n--cg-debug\r\n--pretty-print-debug:false\r\n--pretty-print-debug-visible-spaces:true",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Parse & Save": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d0\r\n--parse-only --allow-errors\r\n--messages Warning\r\n--program \"c sort\" --report-all",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB Console": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d0 --allow-errors\r\n--messages Warning --lab\r\n--program \"c\" --pretty-print-debug:false\r\n--console:true",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Parse & Save Detailed": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5\r\n--parse-only --allow-errors\r\n--messages Warning\r\n--program \"c sort\" --report-all",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Sparx": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5\r\n--sparx-model",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    }
  }
}