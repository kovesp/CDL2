{
  "profiles": {
    "CodeGen": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v3 -d3 --allow-errors\r\n--messages Warning",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Pretty Print": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d3\r\n--pretty-print window --parse-only\r\n--allow-errors --save\r\n",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5 --allow-errors\r\n--messages Warning --lab --console:false\r\n--cg-debug --pretty-print-debug:false",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Parse & Save": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5\r\n--parse-only --allow-errors\r\n--messages Warning\r\n--program \"csharp sort\" --report-all",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB Console": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d0 --allow-errors\r\n--messages Warning --lab\r\n--program \"csharp sort\" --pretty-print-debug:false\r\n--console",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    }
  }
}