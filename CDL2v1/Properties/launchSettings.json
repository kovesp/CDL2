{
  "profiles": {
    "CodeGen": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v3 -d3 --allow-errors\r\n--messages Warning",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Pretty Print": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d3\r\n--pretty-print window --parse-only\r\n--allow-errors --save\r\n",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5 --allow-errors\r\n--messages Warning --lab\r\n--pretty-print-debug --cg-debug\r\n--program \"csharp sort\"",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "Parse & Save": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v0 -d5\r\n--parse-only --allow-errors\r\n--messages Info --report-all",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    },
    "LAB Console": {
      "commandName": "Project",
      "commandLineArgs": "--sources Quicksort.cdl2 -v5 -d5 --allow-errors\r\n--messages Warning --lab\r\n--pretty-print-debug --cg-debug\r\n--program \"csharp sort\"\r\n--console --ansi",
      "workingDirectory": "$(ProjectDir)\\CDL2"
    }
  }
}