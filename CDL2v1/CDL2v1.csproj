<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <UseWindowsForms>false</UseWindowsForms>
    <ApplicationIcon>CDL-V1.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);DEBUG</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="CDL-V1.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CDL2\**\*.cs" />
    <None Include="CDL2\**\*.cs" />
  </ItemGroup>
  
    <!-- Package reference for ALL target frameworks  
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>
 -->

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
     <Reference Include="PresentationCore, Version=10.0.0.0,Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
     <Reference Include="PresentationFramework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
     <Reference Include="WindowsBase, Version=10.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CDL2v1-Linux.csproj" />
  </ItemGroup>

  <!-- Suppress WPF warnings when building for non-Windows platforms -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' AND !$(RuntimeIdentifier.StartsWith('win'))">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Compute version M.m.b number from last git tag of vM.m and b the number of commits since the tag -->
  <Target Name="ComputeGitVersion" BeforeTargets="GenerateAssemblyInfo">
    <Exec Command="git describe --tags --match &quot;v*&quot; --abbrev=0"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitTag" />
    </Exec>

    <Exec Command="git rev-list $(GitTag)..HEAD --count"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitHeight" />
    </Exec>

    <!-- strip leading 'v' -->
    <PropertyGroup>
      <BaseVersion>$([System.String]::Copy($(GitTag)).TrimStart('v'))</BaseVersion>
      <Version>$(BaseVersion).$(GitHeight)</Version>
    </PropertyGroup>
  </Target>

  <PropertyGroup>
    <Version>$(Version)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(BaseVersion).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

</Project>
