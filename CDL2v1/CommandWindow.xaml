<!-- CommandPromptWindow.xaml -->
<Window x:Class="CDL2v1.CommandPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDL2 Lab" Height="1200" Width="900"
        Background="Black">
   <Grid>
      <Grid.RowDefinitions>
         <RowDefinition Height="*" />
         <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Output Area -->
      <ListBox x:Name="OutputListBox" 
                 Grid.Row="0" 
                 Background="DarkSlateGray" 
                 Foreground="LightGray"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="14"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 IsTabStop="False"
                 Focusable="False" />

      <!-- Input Area -->
      <DockPanel Grid.Row="1" LastChildFill="True">
         <TextBlock x:Name="PromptTextBlock" 
                       DockPanel.Dock="Left"
                       Text="> " 
                       Foreground="LightGray" 
                       Background="Black"
                       FontFamily="Consolas"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0" />

         <TextBox x:Name="InputTextBox"
                     Background="DarkSlateGray"
                     Foreground="White"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     FontSize="16"
                     CaretBrush="White"
                     KeyDown="InputTextBox_KeyDown" />
      </DockPanel>
   </Grid>
</Window>
