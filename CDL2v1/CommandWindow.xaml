<!-- CommandPromptWindow.xaml -->
<Window x:Class="CDL2v1.CommandPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDL2 Command Window" Height="1200" Width="800"
        Background="Black">
    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OutputRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Output Area -->
        <ListBox x:Name="OutputListBox" 
                 Grid.Row="0" 
                 Background="DarkSlateGray" 
                 Foreground="LightGray"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 IsTabStop="False"
                 Focusable="False" />

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      Height="5"
                      Background="#444444"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center">
                            <Button Content="≡" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Foreground="LightGray"
                                    ToolTip="Toggle output area"
                                    Click="ToggleOutputArea_Click"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Input Area -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <TextBlock x:Name="PromptTextBlock" 
                       DockPanel.Dock="Left"
                       Text="> " 
                       Foreground="LightGray" 
                       Background="Black"
                       FontFamily="Consolas"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0" />

            <TextBox x:Name="InputTextBox"
                     Background="DarkSlateGray"
                     Foreground="White"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     CaretBrush="White"
                     KeyDown="InputTextBox_KeyDown" />
        </DockPanel>
    </Grid>
</Window>

