<!-- CommandPromptWindow.xaml -->
<Window x:Class="CDL2v1.CommandPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDL2 Command Window" Height="1200" Width="800"
        Background="DarkSlateGray">
    <Grid x:Name="MainGrid" Background="DarkSlateGray">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OutputRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Output Area -->
        <ListBox x:Name="OutputListBox" 
                 Grid.Row="0" 
                 Background="DarkSlateGray" 
                 Foreground="LightGray"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 IsTabStop="False"
                 Focusable="False" />

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      Height="10"
                      Background="#444444"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Rows"
                      Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- Make toggle button much more visible -->
                        <Border Width="40" 
                                Height="10" 
                                Background="#666666" 
                                BorderBrush="#999999" 
                                BorderThickness="1" 
                                CornerRadius="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Button Content=" " 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    ToolTip="Toggle output area"
                                    Click="ToggleOutputArea_Click"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Width="40"
                                                            Height="10"
                                                            CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                         VerticalAlignment="Center" 
                                                                         Margin="0,-2,0,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#888888"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#AAAAAA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Input Area - Set Background explicitly for all elements -->
        <DockPanel Grid.Row="2" LastChildFill="True" Background="DarkSlateGray">
            <TextBlock x:Name="PromptTextBlock" 
                       DockPanel.Dock="Left"
                       Text="> " 
                       Foreground="LightGray" 
                       Background="DarkSlateGray"
                       FontFamily="Consolas"
                       VerticalAlignment="Center"
                       Margin="2,0,0,0" />

            <TextBox x:Name="InputTextBox"
                     Background="DarkSlateGray"
                     Foreground="White"
                     BorderThickness="0"
                     FontFamily="Consolas"
                     CaretBrush="White"
                     PreviewKeyDown="InputTextBox_PreviewKeyDown" />
        </DockPanel>
    </Grid>
</Window>

