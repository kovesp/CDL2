<!-- CommandPromptWindow.xaml -->
<Window x:Class="CDL2v1.CommandPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDL2 Command Window" Height="1200" Width="800"
        Background="DarkSlateGray">
    <Grid x:Name="MainGrid" Background="DarkSlateGray">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="OutputRow" Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Output Area - Fixing the narrow column issue -->
        <ScrollViewer x:Name="OutputScrollViewer" Grid.Row="0" 
                      Background="DarkSlateGray" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <RichTextBox x:Name="OutputTextBlock" 
                       Background="DarkSlateGray" 
                       Foreground="LightGray"
                       BorderThickness="0"
                       FontFamily="Cascadia Mono"
                       FontSize="14"
                       IsReadOnly="True"
                       IsDocumentEnabled="True"
                       Margin="10"
                       HorizontalAlignment="Stretch"
                       Width="Auto">
                <RichTextBox.Document>
                    <FlowDocument PageWidth="2000" 
                                 TextAlignment="Left" 
                                 IsOptimalParagraphEnabled="True"
                                 IsHyphenationEnabled="False">
                        <!-- Document content goes here -->
                    </FlowDocument>
                </RichTextBox.Document>
                <RichTextBox.Resources>
                    <Style TargetType="{x:Type Paragraph}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </RichTextBox.Resources>
            </RichTextBox>
        </ScrollViewer>

        <!-- Splitter with more visible toggle button -->
        <GridSplitter Grid.Row="1"
                    Height="10"
                    Background="#444444"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    ResizeBehavior="PreviousAndNext"
                    ResizeDirection="Rows"
                    Cursor="SizeNS">
            <GridSplitter.Template>
                <ControlTemplate TargetType="{x:Type GridSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <!-- More visible toggle button -->
                        <Border Width="80" 
                                Height="16" 
                                Background="#666666" 
                                BorderBrush="#999999" 
                                BorderThickness="1" 
                                CornerRadius="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Button Content="≡" 
                                    Background="Transparent" 
                                    BorderThickness="0"
                                    Foreground="White"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    ToolTip="Toggle output area"
                                    Click="ToggleOutputArea_Click"
                                    Cursor="Hand"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Width="80"
                                                            Height="16"
                                                            CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center" 
                                                                        VerticalAlignment="Center" 
                                                                        Margin="0,-2,0,0" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#888888"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#AAAAAA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Border>
                        
                        <!-- Grip lines for better visibility -->
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,2"
                                  IsHitTestVisible="False">
                            <Rectangle Height="1" Width="50" Fill="#777777"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" 
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,4"
                                  IsHitTestVisible="False">
                            <Rectangle Height="1" Width="50" Fill="#777777"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Input Area with proper background -->
        <DockPanel Grid.Row="2" LastChildFill="True" Background="DarkSlateGray" Margin="0,0,0,10">
            <TextBlock x:Name="PromptTextBlock" 
                     DockPanel.Dock="Left"
                     Text="> " 
                     Foreground="LightGray" 
                     Background="DarkSlateGray"
                     FontFamily="Cascadia Mono"
                     VerticalAlignment="Center"
                     Margin="10,0,0,0" />

            <TextBox x:Name="InputTextBox"
                   Background="DarkSlateGray"
                   Foreground="White"
                   BorderThickness="0"
                   FontFamily="Cascadia Mono"
                   CaretBrush="White"
                   Margin="0,5,10,5"
                   PreviewKeyDown="InputTextBox_PreviewKeyDown" />
        </DockPanel>
        
        <!-- Zoom buttons -->
        <StackPanel Grid.Row="0" 
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Orientation="Horizontal"
                  Margin="0,10,10,0">
            <Button Content="+" 
                   Width="25" 
                   Height="25" 
                   Margin="5,0,0,0"
                   Background="#555555"
                   Foreground="White"
                   BorderBrush="#777777"
                   Click="ZoomIn_Click"
                   ToolTip="Zoom In (Ctrl+Mouse Wheel)" />
            <Button Content="-" 
                   Width="25" 
                   Height="25" 
                   Margin="5,0,0,0"
                   Background="#555555"
                   Foreground="White"
                   BorderBrush="#777777"
                   Click="ZoomOut_Click"
                   ToolTip="Zoom Out (Ctrl+Mouse Wheel)" />
        </StackPanel>
    </Grid>
</Window>

