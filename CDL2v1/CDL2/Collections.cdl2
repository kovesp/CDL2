#cspell:ignore ENDMOD ENDLAY ENDSEC hashtables

MODULE collections.
   LAYER collections.
      SECTION container.
         ACTION initialize container = 
            "[Hashtable]$$script:Container = @{}"
            "$l $$global:bounds-check = {params($$name,$$i,$$lwb,$$size) if ($$i -lt $$lwb || $$i -gt $$size-$$lwb+1) throw "Array index $$i}
            "$l $$global:array-getter = {params($$name,$$lwb,$$size) { return {params($i) }}}
      ENDSEC container.
      PRELUDE initialize container.
      SECTION creators.
         EXPORT new array, new hashtable, new set.
         PREDICATE new array*name+>size+>lwb =
            "$l if ($$Container.ContainsKey("name")) { return $$false }"
            "$l $$Container["name"] = ($"array$",[Int64[]]::new("size"),)"
            "$l return $true".         
         PREDICATE new hash*name*type =
            "$l if ($$Container.ContainsKey("name")) { return $$false }"
            "$l $$Container["name"] = ("type",@{})"
            "$l return $true".
         PREDICATE new hashtable*name: new hash+name+"hashtable".
         PREDICATE new set*name:       new hash+name+"set". 
      ENDSEC creators.
      SECTION accessors.
         TEST get element*name+>index+value> =
         "$l if (! $$Container.ContainsKey("name") || $$Container["name"][0] -eq $"set$") { return $$false }"
         "$l if ($$Container["name"][0] -eq $"array$")
         "$l " value " = $$Container["name"]["index"]".
      ENDSEC accessors.
   ENDLAY collections.
ENDMOD collections.
PRELUDE container.