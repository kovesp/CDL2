#=================================================================================


MODULE x64 kernel.
   LAYER kernel.
      SECTION arithmetic.
         EXT incr, decr, incr with, decr with, add, subtract, multiply, multiply by, divide, divide by, remainder, modulo, halve, make, make string.
         EXT gt, lt, ge, le, eq, ne.
         EXT make undefined.

         EXPORT incr, decr, incr with, decr with.
         EXPORT add, subtract, multiply, multiply by, divide, divide by, remainder, modulo, halve.
         EXPORT make, make string.
         EXPORT gt, lt, ge, le, eq, ne.
         EXPORT less or equal.

         EXT const x.
         CONST const x = 1.

         #VAR y.
         #LIST z(x:x).
         #FUNCTION test macro +>a -l = a ; l ; x ; y ; z ; 10 ; 3.14159 "string".

         # Pure assembler code (Intel syntax)
         FUNCTION incr+>a> = "inc qword [" a "]".
         FUNCTION decr+>a> = "dec qword [" a "]".
         FUNCTION incr with +>a>+>b = "add qword [" a "], qword [" b "]".
         FUNCTION decr with +>a>+>b = "sub qword [" a "], qword [" b "]".

         FUNCTION add +>a+>b+c> = 
            "$L mov rax, qword [" a "]"
            "$L nadd rax, qword [" b "]"
            "$L mov qword [" c "], rax".

         FUNCTION subtract +>a+>b+c> =
            "$L mov rax, qword [" a "]"
            "$L sub rax, qword [" b "]"
            "$L mov qword [" c "], rax".
         FUNCTION multiply +>a+>b+c> =
            "$L mov rax, qword [" a "]"
            "$L imul rax, qword [" b "]"
            "$L mov qword [" c "], rax".
         FUNCTION multiply by+>a>+>b = "$L imul qword [" a "] , qword [" b "]".
         FUNCTION divide +>a+>b+c> =
            "$L mov rax, qword [" a "]"
            "$L cqo"
            "$L idiv qword [" b "]"
            "$L mov qword [" c "], rax".
         FUNCTION divide by+>a>+>b =
            "$L mov rax, qword [" a "]"
            "$L cqo"
            "$L idiv qword [" b "]"
            "$L mov qword [" a "], rax".
         FUNCTION remainder +>a+>b+c> =
            "$L mov rax, qword [" a "]"
            "$L cqo"
            "$L idiv qword [" b "]"
            "$L mov qword [" c "], rdx".
         FUNCTION modulo +>a+>b+c> =
            "$L mov rax, qword [" a "]"
            "$L cqo"
            "$L idiv qword [" b "]"
            "$L mov qword [" c "], rdx".

         FUNCTION halve +>a> = "$L sar qword [" a "], 1".
         FUNCTION make +a>+>b = "$L mov rax, qword [" b "]$L mov qword [" a "], rax".
         FUNCTION make string +a>*b = "; string assignment not supported in pure asm".
         FUNCTION make undefined+x> = "$L mov qword [" x "], 0xDEADBEEFDEADBEEF".

         TEST eq+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L sete al".
         TEST ne+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L setne al".
         TEST gt+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L setg al".
         TEST ge+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L setge al".
         TEST lt+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L setl al".
         TEST le+>a+>b =
            "$L mov rax, qword [" a "]"
            "$L cmp rax, qword [" b "]"
            "$L setle al".

         TEST less or equal+>a+>b: le+a+b.
      ENDSEC arithmetic.

      SECTION touch.
         EXPORT touch in, touch out, touch trans.
         FUNCTION touch in+>v = "; nop (touch in)".
         FUNCTION touch out+v> = "; nop (touch out)".
         FUNCTION touch trans+>v> = "; nop (touch trans)".
      ENDSEC touch.

      SECTION data.
         EXPORT smaller element, swap element, get element, set element, set element to, is data sorted macro.
         INV show msg no newline.

         IMPORT lwb, upb.
         CONST lwb, upb.

         # The array to be sorted. #
         LIST data(lwb:upb).

         # Use x64 assembly for element comparison and swap

         TEST smaller element +>p+>q =
            "$L mov rax, qword [" data "+" p "]"
            "$L cmp rax, qword [" data "+" q "]"
            "$L setl al".
         ACTION swap element +>i+>j =
            "$L mov rax, qword [" data "+" i "]"
            "$L mov rbx, qword [" data "+" j "]"
            "$L mov qword [" data "+" i "], rbx"
            "$L mov qword [" data "+" j "], rax".
         FUNCTION get element +>i+v> =
            "$L mov rax, qword [" data "+" i "]"
            "$L mov qword [" v "], rax".
         ACTION set element +>i+>v =
            "$L mov rax, qword [" v "]"
            "$L mov qword [" data "+" i "], rax".
         ACTION set element to+>p+>q =
            "$L mov rax, qword [" data "+" q "]"
            "$L mov qword [" data "+" p "], rax".

         TEST is data sorted macro +>to -i -r =
            "$L mov qword [" r "], 1"
            "$L mov rcx, qword [" lwb "]"
            "$L _sort_loop:"
            "$L cmp rcx, qword [" to "]"
            "$L jge _sort_done"
            "$L mov rax, qword [" data "+rcx]"
            "$L mov rbx, qword [" data "+rcx+1]"
            "$L cmp rax, rbx"
            "$L jle _sort_next"
            "$L mov qword [" r "], 0"
            "$L jmp _sort_done"
            "$L _sort_next:"
            "$L inc rcx"
            "$L jmp _sort_loop"
            "$L _sort_done:".
      ENDSEC data.
   ENDLAY kernel.
ENDMOD x64 kernel.

#=================================================================================


MODULE windows x64 kernel.
   LAYER kernel.
      SECTION messages.
         EXPORT show msg, show msg no newline, show number.
         # Windows x64: Use WriteFile syscall
         # string: rdx points to [4-byte length][string][0]
         # Output: +x> and +>x> are addresses
         # string: pointer to [4-byte length][string][0]
         # written: pointer to DWORD for bytes written
         ACTION show msg*string =
            "$L mov rcx, 0xFFFFFFFFFFFFFFF6 ; STD_OUTPUT_HANDLE (-10)"
            "$L mov rdx, " string
            "$L mov eax, dword ptr [rdx]"
            "$L add rdx, 4"
            "$L mov r8, rax"
            "$L mov r9, 0 ; NULL for lpNumberOfBytesWritten"
            "$L mov rax, WriteFile"
            "$L call rax"
            "$L sub rsp, 8"
            "$L mov word ptr [rsp], 0x0A0D"
            "$L mov rcx, 0xFFFFFFFFFFFFFFF6"
            "$L lea rdx, [rsp]"
            "$L mov r8, 2"
            "$L mov r9, 0"
            "$L mov rax, WriteFile"
            "$L call rax"
            "$L add rsp, 8".
         ACTION show number +>number =
            "; Convert number at " number " to string ([len][str][0]), then call show msg*string".
         ACTION show msg no newline*string =
            "$L mov rcx, 0xFFFFFFFFFFFFFFF6"
            "$L mov rdx, " string
            "$L mov eax, dword ptr [rdx]"
            "$L add rdx, 4"
            "$L mov r8, rax"
            "$L mov r9, 0 ; NULL for lpNumberOfBytesWritten"
            "$L mov rax, WriteFile"
            "$L call rax".
      ENDSEC messages.
      SECTION timer.
         EXPORT start timer, stop timer, show elapsed time, get elapsed time.
         VAR start, stop.
         # Use QueryPerformanceCounter/QueryPerformanceFrequency
         ACTION start timer = "$L call QueryPerformanceCounter ; result in [start]".
         ACTION stop timer = "$L call QueryPerformanceCounter ; result in [stop]".
         FUNCTION get elapsed time+elapsed> = "$L sub rax, [start]$L mov [elapsed], rax ; ticks".
         ACTION show elapsed time = "$L ; Convert ticks to ms and print (see MSDN for details)".
      ENDSEC timer.
      SECTION command line.
         EXPORT command line argument count, is command line argument, is command line argument numeric, get program name.
         # Windows x64: Use GetCommandLineW and CommandLineToArgvW
         # +count> is address
         # +count>: pointer to DWORD
         FUNCTION command line argument count+count> =
            "$L call GetCommandLineW"
            "$L call CommandLineToArgvW"
            "$L mov dword ptr [" count "], argc".
         # +>n: value, *arg: pointer to [len][str][0]
         TEST is command line argument+>n*arg =
            "$L ; Compare pointer to argv[" n "] (as [len][str][0]) to " arg " (same format)"
            "$L ; Use length and 0-terminated string for comparison".
         TEST is command line argument numeric+>n+number> =
            "$L ; Parse argv[" n "] as number, store at " number"".
         FUNCTION get program name+prog name> =
            "$L ; Copy argv[0] (as [len][str][0]) to " prog name.
      ENDSEC command line.
      SECTION arithmetic.
         EXPORT random.
         FUNCTION random+>min+>max+r> =
            "$L mov rcx, <address of r>$L mov rdx, 8$L mov rax, <address of SystemFunction036 (RtlGenRandom)>$L call rax$L mov rax, [r]$L ; scale to min/max if needed".
      ENDSEC arithmetic.
   ENDLAY kernel.
ENDMOD windows x64 kernel.

#=================================================================================


MODULE linux x64 kernel.
   LAYER kernel.
      SECTION messages.
         EXPORT show msg, show msg no newline, show number.
         # Linux x64: syscall write(1, ...)
         # string: rsi points to [4-byte length][string][0]
         # Output: +x> and +>x> are addresses
         # string: pointer to [4-byte length][string][0]
         ACTION show msg*string =
            "$L mov rax, 1 ; sys_write"
            "$L mov rdi, 1 ; stdout"
            "$L mov rsi, " string
            "$L mov edx, dword ptr [rsi]"
            "$L add rsi, 4"
            "$L syscall"
            "$L sub rsp, 8"
            "$L mov byte ptr [rsp], 0x0A"
            "$L mov rax, 1"
            "$L mov rdi, 1"
            "$L lea rsi, [rsp]"
            "$L mov edx, 1"
            "$L syscall"
            "$L add rsp, 8".
         ACTION show number +>number =
            "; Convert number at " number " to string ([len][str][0]), then call show msg*string".
         ACTION show msg no newline*string =
            "$L mov rax, 1"
            "$L mov rdi, 1"
            "$L mov rsi, " string
            "$L mov edx, dword ptr [rsi]"
            "$L add rsi, 4"
            "$L syscall".
      ENDSEC messages.
      SECTION timer.
         EXPORT start timer, stop timer, show elapsed time, get elapsed time.
         VAR start, stop.
         # Use clock_gettime syscall
         ACTION start timer = "$L mov rax, 228 ; sys_clock_gettime$L mov rdi, 1 ; CLOCK_MONOTONIC$L mov rsi, <address of start>$L syscall".
         ACTION stop timer = "$L mov rax, 228$L mov rdi, 1$L mov rsi, <address of stop>$L syscall".
         FUNCTION get elapsed time+elapsed> = "$L ; Subtract start from stop, convert to ms".
         ACTION show elapsed time = "$L ; Print elapsed time (see man clock_gettime)".
      ENDSEC timer.
      SECTION command line.
         EXPORT command line argument count, is command line argument, is command line argument numeric, get program name.
         # Linux x64: argc/argv from stack at entry
         # +count> is address
         # +count>: pointer to DWORD
         FUNCTION command line argument count+count> =
            "$L mov rax, [rsp]"
            "$L mov dword ptr [" count "], eax".
         # +>n: value, *arg: pointer to [len][str][0]
         TEST is command line argument+>n*arg =
            "$L ; Compare pointer to argv[" n "] (as [len][str][0]) to " arg " (same format)"
            "$L ; Use length and 0-terminated string for comparison".
         TEST is command line argument numeric+>n+number> =
            "$L ; Parse argv[" n "] as number, store at " number"".
         FUNCTION get program name+prog name> =
            "$L ; Copy argv[0] (as [len][str][0]) to " prog name.
      ENDSEC command line.
      SECTION arithmetic.
         EXPORT random.
         FUNCTION random+>min+>max+r> =
            "$L mov rax, 318 ; sys_getrandom"
            "$L mov rdi, <address of r>"
            "$L mov rsi, 8"
            "$L mov rdx, 0"
            "$L syscall"
            "$L mov rax, [r]"
            "$L ; scale to min/max if needed".
      ENDSEC arithmetic.
   ENDLAY kernel.
ENDMOD linux x64 kernel.
