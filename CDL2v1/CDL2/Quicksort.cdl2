# Ignore Spelling: lwb upb eq ne ge namespace str concat io fac prog decr cspell
# Ignore Spelling: ENDMOD ENDLAY ENDSEC quicksort incr msg sortedness
# cspell:ignore ENDMOD ENDLAY ENDSEC ENDPROG decr ABSTR incr decr sortedness
#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
MODULE powershell kernel.
   LAYER kernel.
      SECTION arithmetic.
         EXT incr, decr, incr with, decr with, add, subtract, multiply, divide, remainder, modulo, halve, make, make string, random.
         EXT gt, lt, ge, le, eq, ne.

         EXPORT incr, decr, incr with, decr with.
         EXPORT add, subtract, multiply, divide, remainder, modulo, halve.
         EXPORT make, make string, random.
         EXPORT gt, lt, ge, le, eq, ne.
         EXPORT less or equal.

         EXT const x.
         CONST const x = 1.

         #VAR y.
         #LIST z(x:x).
         #FUNCTION test macro +>a -l = a ; l ; x ; y ; z ; 10 ; 3.14159 "string".

         FUNCTION incr+>a> = a "++".
         FUNCTION decr+>a> = a "--".
         FUNCTION incr with +>a>+>b = a " += " b.
         FUNCTION decr with +>a>+>b = a " -= " b.

         FUNCTION add +>a+>b+c> = c " = " a " + " b.
         FUNCTION subtract +>a+>b+c> = c " = " a " - " b.
         FUNCTION multiply +>a+>b+c> = c " = " a " * " b.
         FUNCTION divide +>a+>b+c> = c " = " a " / " b.
         FUNCTION remainder +>a+>b+c> = c " = " a " - " a " / " b " * " b.
         FUNCTION modulo +>a+>b+c> = c " = " a " % " b.

         FUNCTION halve +>a> = a " /= 2".
         FUNCTION make +a>+>b = a " = " b.
         FUNCTION make string +a>*b = a " = " b.

         TEST eq+>a+>b = a " -eq " b.
         TEST ne+>a+>b = a " -ne " b.
         TEST gt+>a+>b = a " -gt " b.
         TEST ge+>a+>b = a " -ge " b.
         TEST lt+>a+>b = a " -lt " b.
         TEST le+>a+>b = a " -le " b.

         TEST less or equal+>a+>b: le+a+b.

         FUNCTION random+>min+>max+r> = r " = Get-Random -Minimum " min " -Maximum (" max "+1)".
      ENDSEC arithmetic.

      SECTION command line.
         EXPORT command line argument count, command line argument, is command line argument, is command line argument numeric, get program name.

         FUNCTION command line argument count+count> =
            "$L" count " = $$script:args.Count".
         FUNCTION command line argument+>n+arg> =
            "$L" arg " = $$script:args[" n "]".
         TEST is command line argument+>n*arg =
            "$L ($$script:args[[int]" n "] -eq " arg ")". 
         TEST is command line argument numeric+>n+number> =
            "$L $null -ne (" number " = $$script:args[[int]" n "] -as [long])".
         FUNCTION get program name+prog name> =
            "$L" prog name " = $$MyInvocation.MyCommand.Name;".
      ENDSEC command line.

      SECTION touch.
         EXPORT touch in, touch out, touch trans.

         FUNCTION touch in+>v = "[void]" v ";".
         FUNCTION touch out+v> = "[void]" v ";".
         FUNCTION touch trans+>v> = "[void]" v ";".
      ENDSEC touch.

      SECTION timer.
         EXPORT start timer, stop timer, show elapsed time, get elapsed time.
         INV subtract.

         VAR start, stop.
         FUNCTION get timestamp in miliseconds+ts> = ts " = [DateTimeOffset]::Now.ToUnixTimeMilliseconds()".

         ACTION start timer: get timestamp in miliseconds+start.
         ACTION stop timer: get timestamp in miliseconds+stop.

         FUNCTION get elapsed time+elapsed>: subtract+stop+start+elapsed.
         
         ACTION show elapsed time -elapsed:
            get elapsed time+elapsed, show elapsed time formatted+elapsed. 

         ACTION show elapsed time formatted+>elapsed = 
            "$l Write-Host -ForegroundColor Blue ('Elapsed time: {0:N0} milliseconds' -f " elapsed ")".
      ENDSEC timer.

      SECTION messages.
         EXPORT show msg, show msg no newline, show number.
         EXT show msg, show msg no newline, show number.

         ACTION show msg*string = "Write-Host " string.
         ACTION show number +>number = "Write-Host -NoNewline ('{0:N0}' -f " number ")".
         ACTION show msg no newline*string = "Write-Host -NoNewline " string.
      ENDSEC messages.

      SECTION data.
         EXPORT smaller element, swap element, get element, set element, set element to, is data sorted macro.
         EXPORT sort data, show native sorter.
         INV show msg no newline.

         IMPORT lwb, upb.
         CONST lwb, upb.

         # The array to be sorted. #
         LIST data(lwb:upb).

         TEST smaller element +>p+>q = 
            data ".Item(" p ") -lt " data ".Item(" q ")".
         ACTION swap element +>i+>j =
            #get element+p+t, set element to+p+q, set element+q+t.#
            data ".Swap(" i "," j ")".
         FUNCTION get element +>i+v> = 
            v " = " data ".Item(" i ")".
         ACTION set element +>i+>v = 
            data ".Item(" i "," v ")".
         ACTION set element to+>p+>q =
            data ".Item(" p "," data ".Item(" q "))".

         TEST is data sorted macro +>to -i -r =
            "$l " r " = 1"
            "$l for (" i " = " lwb " ; " i " -lt " to " ; " i "++) {"
            "$l    if (" data ".Item(" i ") -gt " data ".Item(" i " + 1)) { " r " = 0; break }"
            "$l }"
            "$l [bool]" r.

         # Sort the array using the built-in sort method. For execution time comparison. #
         ACTION sort data+>to =
            "$L[Array]::Sort(" data ".array, " lwb ", " to " - " lwb " + 1)".
         ACTION show native sorter:
            show msg no newline+"[Array]::Sort".
      ENDSEC data.
   ENDLAY kernel.
ENDMOD powershell kernel.

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

MODULE csharp kernel.
   LAYER kernel.
      SECTION arithmetic.
         EXT incr, decr, incr with, decr with, add, subtract, multiply, divide, remainder, modulo, halve, make, make string, random.
         EXT gt, lt, ge, le, eq, ne.

         EXPORT incr, decr, incr with, decr with.
         EXPORT add, subtract, multiply, divide, remainder, modulo, halve.
         EXPORT make, make string, random.
         EXPORT gt, lt, ge, le, eq, ne.
         EXPORT less or equal.

         EXT const x.
         CONST const x = 1.

         #VAR y.
         #LIST z(x:x).
         #FUNCTION test macro +>a -l = a ; l ; x ; y ; z ; 10 ; 3.14159 "string".

         FUNCTION incr+>a> = a "++;".
         FUNCTION decr+>a> = a "--;".
         FUNCTION incr with +>a>+>b = a " += " b ";".
         FUNCTION decr with +>a>+>b = a " -= " b ";".

         FUNCTION add +>a+>b+c> = c " = " a " + " b ";".
         FUNCTION subtract +>a+>b+c> = c " = " a " - " b ";".
         FUNCTION multiply +>a+>b+c> = c " = " a " * " b ";".
         FUNCTION divide +>a+>b+c> = c " = " a " / " b ";".
         FUNCTION remainder +>a+>b+c> = c " = " a " - " a " / " b " * " b ";".
         FUNCTION modulo +>a+>b+c> = c " = " a " % " b ";".

         FUNCTION halve +>a> = a " /= 2;".
         FUNCTION make +a>+>b = a " = " b ";".
         FUNCTION make string +a>*b = a " = " b.

         TEST eq+>a+>b = a " == " b.
         TEST ne+>a+>b = a " != " b.
         TEST gt+>a+>b = a " > " b.
         TEST ge+>a+>b = a " >= " b.
         TEST lt+>a+>b = a " < " b.
         TEST le+>a+>b = a " <= " b.

         TEST less or equal+>a+>b: le+a+b.

         FUNCTION random+>min+>max+r> = r " = System.Random.Shared.Next((int)" min ", (int)" max " + 1);".
      ENDSEC arithmetic.

      SECTION command line.
         EXPORT command line argument count, command line argument, is command line argument, is command line argument numeric, get program name.

         FUNCTION command line argument count+count> =
            "$L" count " = Program.args.Length;".
         FUNCTION command line argument+>n+arg> =
            "$L" arg " = Program.args[" n "];".
         TEST is command line argument+>n*arg =
            "$L Program.args[(int)" n "] == " arg. 
         TEST is command line argument numeric+>n+number> =
            "$Llong.TryParse(Program.args[(int)" n "], out " number ")".
         FUNCTION get program name+prog name> =
            "$L" prog name " = System.Environment.GetCommandLineArgs()[0];".
      ENDSEC command line.

      SECTION touch.
         EXPORT touch in, touch out, touch trans.

         FUNCTION touch in+>v = "(void)" v.
         FUNCTION touch out+v> = "(void)" v.
         FUNCTION touch trans+>v> = "(void)" v.
      ENDSEC touch.

      SECTION timer.
         EXPORT start timer, stop timer, show elapsed time, get elapsed time.
         INV subtract, divide.

         VAR start, stop.

         ACTION start timer = start " = System.DateTime.Now.Ticks;".
         ACTION stop timer  = stop " = System.DateTime.Now.Ticks;".

         CONST tick = 10_000.
         FUNCTION get elapsed time+elapsed> -elapsed ticks: 
            subtract+stop+start+elapsed ticks, divide+elapsed ticks+tick+elapsed.

         ACTION show elapsed time = 
            "System.Console.WriteLine($$$"Elapsed time: {((" stop " - " start ") / 10000.0):N0} milliseconds$");".
      ENDSEC timer.

      SECTION messages.
         EXPORT show msg, show msg no newline, show number.
         EXT show msg, show msg no newline, show number.

         ACTION show msg*string = "System.Console.WriteLine(" string ");".
         ACTION show number +>number = "System.Console.Write($$$"{" number ":N0}$");".
         ACTION show msg no newline*string = "System.Console.Write(" string ");".
      ENDSEC messages.

      SECTION data.
         EXPORT smaller element, swap element, get element, set element, set element to,is data sorted macro.
         EXPORT sort data, show native sorter.
         INV show msg no newline.

         IMPORT lwb, upb.
         CONST lwb, upb.

         # The array to be sorted. #
         LIST data(lwb:upb).

         TEST smaller element +>p+>q = 
            data "[" p "] < " data "[" q "]".
         ACTION swap element +>i+>j =
            data ".Swap(" i ", " j ");".
         FUNCTION get element +>i+v> = 
            v " = " data "[" i "];".
         ACTION set element +>i+>v = 
            data "[" i "] = " v ";".
         ACTION set element to+>p+>q =
            data "[" p "] = " data "[" q "];".

         TEST is data sorted macro +>to -i -r =
            r " = 1;"
            "$Lfor (" i " = " lwb "; " i " < " to "; " i "++) {"
            "$L   if (" data "[" i "] > " data "[" i " + 1]) {"
            "$L      " r " = 0;"
            "$L      break;"
            "$L   }"
            "$L}"
            "$L" r " == 1".

         # Sort the array using the built-in sort method. For execution time comparison. #
         ACTION sort data+>to =
            "System.Array.Sort(" data ".array, 0, (int)" to " - (int)" lwb " + 1);".
         ACTION show native sorter: 
            show msg no newline+".Net System.Array.Sort".
      ENDSEC data.
   ENDLAY kernel.
ENDMOD csharp kernel.

#~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

MODULE c kernel.
   LAYER kernel.
      SECTION arithmetic.
         EXT incr, decr, incr with, decr with, add, subtract, multiply, multiply by, divide, divide by, remainder, modulo, halve, make, make string, random.
         EXT gt, lt, ge, le, eq, ne.
         EXT make undefined.

         EXPORT incr, decr, incr with, decr with.
         EXPORT add, subtract, multiply, multiply by, divide, divide by, remainder, modulo, halve.
         EXPORT make, make string, random.
         EXPORT gt, lt, ge, le, eq, ne.
         EXPORT less or equal.

         EXT const x.
         CONST const x = 1.

         #VAR y.
         #LIST z(x:x).
         #FUNCTION test macro +>a -l = a ; l ; x ; y ; z ; 10 ; 3.14159 "string".

         FUNCTION incr+>a> = a "++;".
         FUNCTION decr+>a> = a "--;".
         FUNCTION incr with +>a>+>b = a " += " b ";".
         FUNCTION decr with +>a>+>b = a " -= " b ";".

         FUNCTION add +>a+>b+c> = c " = " a " + " b ";".
         FUNCTION subtract +>a+>b+c> = c " = " a " - " b ";".
         FUNCTION multiply +>a+>b+c> = c " = " a " * " b ";".
         FUNCTION multiply by+>a>+>b = a " *= " b ";".
         FUNCTION divide +>a+>b+c> = c " = " a " / " b ";".
         FUNCTION divide by+>a>+>b = a " /= " b ";".
         FUNCTION remainder +>a+>b+c> = c " = " a " - " a " / " b " * " b ";".
         FUNCTION modulo +>a+>b+c> = c " = " a " % " b ";".

         FUNCTION halve +>a> = a " /= 2;".
         FUNCTION make +a>+>b = a " = " b ";".
         FUNCTION make string +a>*b = a " = " b ";".
         FUNCTION make undefined+x> = x " = VALUE_UNDEFINED;".

         TEST eq+>a+>b = a " == " b.
         TEST ne+>a+>b = a " != " b.
         TEST gt+>a+>b = a " > " b.
         TEST ge+>a+>b = a " >= " b.
         TEST lt+>a+>b = a " < " b.
         TEST le+>a+>b = a " <= " b.

         TEST less or equal+>a+>b: le+a+b.

         FUNCTION random+>min+>max+r> = r " = " min " + rand() % ((" max ") - (" min ") + 1);".
      ENDSEC arithmetic.

      SECTION command line.
         EXPORT command line argument count, is command line argument, is command line argument numeric, get program name.

         FUNCTION command line argument count+count> =
            "$L" count " = _argc - 1;".
         TEST is command line argument+>n*arg =
            "$Lstrcmp(_argv[(int)" n " + 1]," arg ") == 0".            
         TEST is command line argument numeric+>n+number> =
            "$Lsscanf(_argv[(int)" n " + 1],VALUE_DEC_FORMAT,&" number ") == 1".
         FUNCTION get program name+prog name> =
            "$L" prog name " = _argv[0];".
      ENDSEC command line.

      SECTION touch.
         EXPORT touch in, touch out, touch trans.

         FUNCTION touch in+>v = "(void)" v.
         FUNCTION touch out+v> = "(void)" v.
         FUNCTION touch trans+>v> = "(void)" v.
      ENDSEC touch.
      
      SECTION timer.
         EXPORT start timer, stop timer, show elapsed time, get elapsed time.

         VAR start, stop.

         ACTION start timer = start " = clock();".
         ACTION stop timer  = stop " = clock();".
         
         FUNCTION get elapsed time+elapsed> =
            "$L" elapsed " = (VALUE)((" stop " - " start ") * 1000.0 / CLOCKS_PER_SEC);".

         ACTION show elapsed time = 
            "$Lprintf($"Elapsed time: %.0f milliseconds\n$", ((double)(" stop " - " start ") * 1000.0 / CLOCKS_PER_SEC));".
      ENDSEC timer.

      SECTION messages.
         EXPORT show msg, show msg no newline, show number.
         EXT show msg, show msg no newline, show number.
         INV gt, divide, remainder.

         ACTION show msg*string = "printf($"%s\n$", " string ");".
         ACTION base show number +>number +>width = "printf(VALUE_DEC_FMT(" width ")," number ");".
         
         CONST n1000 = 1000, w3 = 3, w1 = 1.
         ACTION show number +>number -high -low:
            gt+number+n1000, divide+number+n1000+high, remainder+number+n1000+low, 
               show number+high, show msg no newline+",", base show number+low+w3;
            base show number+number+w1.

         ACTION show msg no newline*string = "printf($"%s$", " string ");".
      ENDSEC messages.

      SECTION data.
         EXPORT smaller element, swap element, get element, set element, set element to, is data sorted macro.
         EXPORT sort data, show native sorter.
         INV show msg no newline.

         IMPORT lwb, upb.
         CONST lwb, upb.

         # The array to be sorted. #
         LIST data(lwb:upb).

         TEST smaller element +>p+>q = 
            "CDL2_LIST_GET(" data ", " p ") < CDL2_LIST_GET(" data ", " q ")".
         ACTION swap element +>i+>j =
            "CDL2_LIST_SWAP(" data ", " i ", " j ");".
         FUNCTION get element +>i+v> = 
            v " = CDL2_LIST_GET(" data ", " i ");".
         ACTION set element +>i+>v = 
            "CDL2_LIST_SET(" data ", " i ", " v ");".
         ACTION set element to+>p+>q =
            "CDL2_LIST_SET(" data ", " p ", CDL2_LIST_GET(" data ", " q "));".

         TEST is data sorted macro +>to -i -r =
            r " = 1;"
            "$Lfor (" i " = " lwb "; " i " < " to "; " i "++) {"
            "$L   if (CDL2_LIST_GET(" data ", " i ") > CDL2_LIST_GET(" data ", " i " + 1)) {"
            "$L      " r " = 0;"
            "$L      break;"
            "$L   }"
            "$L}"
            "$L" r " == 1" .


         # Sort the array using qsort. For execution time comparison. #
         # For this to work, include
         #    int cmpvalue(const void *a, const void *b) { return (*(VALUE*)a - *(VALUE*)b);
         # in CDL2.h which is automatically included in C code generator output.
         ACTION sort data+>to = 
            "$Lqsort(" data "_array, (size_t)(" to " - " lwb " + 1), sizeof(VALUE), cmpvalue);".
         ACTION show native sorter:
            show msg no newline+"C qsort(_,_,cmpvalue)".
      ENDSEC data.
      SECTION dynamic data.
         EXPORT dyn base allocate, dyn base free, dyn base resize, dyn base size, dyn base get data, dyn base set data, null, dyn base clear data.
         INV divide by, multiply by, lt, ne, eq, make, add, incr, subtract, make undefined.

         CONST cell size = "sizeof(VALUE)".

         CONST null = 0.
         CONST zero = 0.

         # Size is in units of CDL2 cells, i.e., cell size*size= size in bytes.
         # There is no implementation idependent way of determining the size of
         # a block returned by malloc. Therefore malloc is used to allocate (size+1) cells,
         # the pointer returned by malloc is incrmented by cell size and the size is stored
         # at the begining of the block.
         PREDICATE dyn base allocate+>size+ptr> -malloc size:
            malloc size+size+malloc size, malloc+malloc size+ptr, store block size+ptr+size.
         ACTION dyn base free+>ptr>:
            ne+ptr+null, malloc ptr+ptr+ptr, free+ptr, make+ptr+null;
            +.
         PREDICATE dyn base resize+>ptr>+>size -malloc size:
            malloc ptr+ptr+ptr, malloc size+size+malloc size, realloc+ptr+malloc size, store block size+ptr+size.
         FUNCTION dyn base size+>ptr+size> -p:
            malloc ptr+ptr+p, dyn base get data+p+zero+size.

         ACTION store block size+>ptr>+>size:
             dyn base set data+ptr+zero+size, add+ptr+cell size+ptr.
         FUNCTION malloc ptr+>ptr+mptr>:
            subtract+ptr+cell size+mptr.
         FUNCTION malloc size+>size+malloc size>:
            make+malloc size+size, incr+malloc size, multiply by+malloc size+cell size.

         PREDICATE malloc+>size+ptr> =
            "(" ptr " = (VALUE)malloc(" size ")) != 0".
         ACTION free+>ptr =
            "$L free((VALUE*)" ptr ");".
         PREDICATE realloc+>ptr>+>new size =
            "(" ptr " = (VALUE)realloc((VALUE*)" ptr "," new size ")) != 0".

         ACTION zero data+>ptr+>from =
            "memset((VALUE*)" ptr " + " from ", 0, (((VALUE*)" ptr ")[-1] - " from ") * " cell size ");".
         ACTION undef data+>ptr+>from -undef -size -i:
            make undefined+undef, dyn base size+ptr+size, make+i+from,
              (lt+i+size, dyn base set data+ptr+i+undef, incr+i, *;
               +).

         # If set, date is cleared to zeros (fast), otherwise to the undefined value.
         TEST clear to zeros: -.
         ACTION dyn base clear data+>ptr+>from:
            clear to zeros, zero data+ptr+from;
            undef data+ptr+from.
            
          
         FUNCTION dyn base get data+>ptr+>index+value> =
            value " = ((VALUE*)" ptr ")[" index "];".
         ACTION dyn base set data+>ptr+>index+>value =
            "((VALUE*)" ptr ")[" index "] = " value ";".
      ENDSEC dynamic data.
   ENDLAY kernel.
ENDMOD c kernel.

#=================================================================================

MODULE dynamic data.
   LAYER kernel.
      SECTION arithmetic.
         IMPORT multiply by, divide by, lt, le, ne, eq, make, add, incr.
         ABSTR multiply by, divide by, lt, le, ne, eq, make, add, incr.

         FUNCTION incr+>a>.
         FUNCTION add +>a+>b+c>.
         FUNCTION multiply by+>a>+>b.
         FUNCTION divide by+>a>+>b.
         FUNCTION make +a>+>b.
         TEST eq+>a+>b.
         TEST ne+>a+>b.
         TEST lt+>a+>b.
         TEST le+>a+>b.
      ENDSEC arithmetic.
      SECTION dynamic data.
         IMPORT dyn base allocate, dyn base resize, dyn base free, dyn base size, dyn base get data, dyn base set data, dyn base clear data, null.
         ABSTR  dyn base allocate, dyn base resize, dyn base free, dyn base size, dyn base get data, dyn base set data, dyn base clear data, null.

         CONST null.

         PREDICATE dyn base allocate+>size+ptr>.
         PREDICATE dyn base resize+>ptr>+>new size.
         ACTION dyn base free+>ptr>.
         FUNCTION dyn base size+>ptr+size>.
         FUNCTION dyn base get data+>ptr+>index+value>.
         ACTION dyn base set data+>ptr+>index+>value.
         ACTION dyn base clear data+>ptr+>from.
      ENDSEC dynamic data.
   ENDLAY kernel.
   LAYER interface.
      SECTION exported api.
         EXPORT dyn allocate, dyn free, dyn resize, dyn size, dyn try get data, dyn try set data, dyn clear data.
         INV dyn base allocate, dyn base resize, dyn base free, dyn base size, dyn base get data, dyn base set data, dyn base clear data, null.
         INV multiply by, divide by, lt, le, ne, eq, make, add, incr.

 
         CONST allocations initial size = 1000.
         CONST allocations expansion size = 1000.

         CONST zero = 0.

         VAR allocations.
         VAR allocations size.

         FUNCTION dyn size+>ptr+size>:
            dyn base size+ptr+size.
         TEST dyn try get data+>ptr+>index+value>:
            valid index+ptr+index, dyn base get data+ptr+index+value.
         PREDICATE dyn try set data+>ptr+>index+>value:
            valid index+ptr+index, dyn base set data+ptr+index+value.
         TEST valid index+>ptr+>index -size:
            le+zero+index, dyn size+ptr+size, lt+index+size.
         PREDICATE dyn allocate+>size+ptr>:
            dyn base allocate+size+ptr, add block+ptr, dyn base clear data+ptr+zero.
         PREDICATE dyn resize+>ptr>+>size -prev ptr -prev size:
            make+prev ptr+ptr, dyn base size+ptr+prev size, dyn base resize+ptr+size, replace block+prev ptr+ptr, dyn base clear data+ptr+prev size.
         ACTION dyn free+>ptr>:
            remove block+ptr, dyn base free+ptr.
         ACTION dyn clear data+>ptr+>from:
            dyn base clear data+ptr+from.

         ACTION add block+>ptr:
            add block from+ptr+zero.
         ACTION add block from+>ptr+>from -i -f:
            ne+ptr+null, make+f+from,
              (find block+null+f+i, dyn base set data+allocations+i+ptr;
               dyn size+allocations+f, expand allocations, *).
         ACTION replace block+>prev ptr+>ptr -i:
            eq+prev ptr+null, add block+ptr;
            find block+prev ptr+zero+i, dyn base set data+allocations+i+ptr;
            ?.
         ACTION remove block+>ptr -found:
            ne+ptr+null, find block+ptr+zero+found, dyn base set data+allocations+found+null;
            +.
         TEST find block+>ptr+>from+i> -stored ptr -size:
             make+i+from, dyn size+allocations+size,
               (check slot: lt+i+size, dyn base get data+allocations+i+stored ptr,
                 (eq+stored ptr+ptr;
                  incr+i, *check slot)).
         ACTION expand allocations -old size -new size:
            make+old size+allocations size, add+allocations size+allocations expansion size+new size,
              (dyn resize+allocations+new size, clear allocations+old size;
               ?).            

         ACTION initialize:
            make+allocations size+allocations initial size,
               dyn base allocate+allocations size+allocations, clear allocations+zero;
            ?.
         ACTION clear allocations+>from -i:
            make+i+from,
              (lt+i+allocations size, dyn base set data+allocations+i+null, incr+i, *;
               +).
       
         ACTION free allocations -ptr -i:
            make+i+zero,
              (lt+i+allocations size, dyn base get data+allocations+i+ptr, dyn free+ptr, incr+i, *;
               dyn base free+allocations).
      ENDSEC exported api.
      PRELUDE initialize.
      POSTLUDE free allocations.
   ENDLAY interface.
ENDMOD dynamic data.
PRELUDE exported api.
POSTLUDE exported api.

#=================================================================================


MODULE dyn memory test.
   LAYER base.
      # Required by SECTION data in the kernels.
      SECTION parametrization.
         EXPORT lwb, upb, min random, max random.
         CONST lwb=1, upb=10.
         CONST min random=0, max random=200.
      ENDSEC parametrization.
      SECTION dynamic data.
         IMPORT dyn allocate, dyn free, dyn resize, dyn size, dyn try get data, dyn try set data.
         ABSTR dyn allocate, dyn free, dyn resize, dyn size, dyn try get data, dyn try set data.

         PREDICATE dyn allocate+>units+ptr>.
         PREDICATE dyn resize + >ptr> + >new units.
         ACTION dyn free+>ptr>.
         FUNCTION dyn size+>ptr+size>.
         TEST dyn try get data+>ptr+>index+value>.
         PREDICATE dyn try set data+>ptr+>index+>value.
      ENDSEC dynamic data.
      SECTION arithmetic.
         ABSTR  multiply by, divide by, make, incr, lt, gt.
         IMPORT multiply by, divide by, make, incr, lt, gt.

         FUNCTION incr+>a>.
         FUNCTION multiply by +>a>+>b.
         FUNCTION divide by +>a>+>b.
         FUNCTION make +a>+>b.
         TEST lt+>a+>b.
         TEST gt+>a+>b.
      ENDSEC arithmetic.      
      SECTION messages.
         ABSTR show msg, show msg no newline, show number.
         IMPORT show msg, show msg no newline, show number.

         ACTION show msg*string.
         ACTION show number +>number.
         ACTION show msg no newline*string.
      ENDSEC messages.
      SECTION command line.
         IMPORT command line argument count, is command line argument, is command line argument numeric, get program name.
         ABSTR command line argument count, is command line argument, is command line argument numeric, get program name, arg1, arg2, arg3.
         EXT command line argument count, is command line argument, is command line argument numeric, get program name, arg1, arg2, arg3.

         CONST arg1=0, arg2=1, arg3=2.

         FUNCTION command line argument count+count>.
         TEST is command line argument+>n*arg.
         TEST is command line argument numeric+>n+number>.
         FUNCTION get program name+prog name>.
      ENDSEC command line.
   ENDLAY base.
   LAYER test.
      SECTION test memory.
         INV dyn allocate, dyn free, dyn resize, dyn size, dyn try get data, dyn try set data.
         INV show msg, show msg no newline, show number, make, incr, multiply by, divide by, lt, gt.
         INV command line argument count, is command line argument numeric, arg1.

         VAR store.
         VAR store size.

         CONST default store size = 5.
         CONST zero = 0, one = 1, two = 2.

         FUNCTION process command line -arg count -size:
            command line argument count+arg count,
              (gt+arg count+arg1, is command line argument numeric+arg1+size, make+store size+size;
               make+store size+default store size).

         ACTION do test:
            dyn allocate+store size+store, show msg no newline+"Allocated memory for ", show number+store size,
               show msg+" items.", compute table of squares+store size, show table;
            show msg+"Memory allocation failed.".

         ACTION compute table of squares+>n -i -x squared -x:
            make+i+zero, make+x+one,
               (next square: lt+i+n, square+x+x squared,
                  (dyn try set data+store+i+x squared, incr+i, incr+x, *next square;
                   ?);
                +).
         ACTION show table -i -v -table size -x:
            make+i+zero, make+x+one, dyn size+store+table size,
               (next item: lt+i+table size, 
                  (dyn try get data+store+i+v, show number+x, show msg no newline+" -> ", show number+v, show msg+"", 
                     incr+i, incr+x, *next item;
                   ?);
                +).
            

         FUNCTION square+>n+n squared>:
            power+n+two+n squared.
         FUNCTION power+>base+>exponent+result> -i:
            make+result+one, make+i+zero,
            (lt+i+exponent, multiply by+result+base, incr+i, *;
             +).

      ENDSEC test memory.
      PRELUDE process command line.
      ROOT do test.
   ENDLAY test.
ENDMOD dyn memory test.
PRELUDE test memory.
ROOT test memory.

#=================================================================================

MODULE quicksort.
   LAYER base.
      SECTION parametrization.
         ABSTR lwb, upb, get data size, min random, max random.
         EXT lwb, upb, max size of list to show, min random, max random, get data size.
         EXPORT lwb, upb, min random, max random.
         INV subtract, incr, decr, min, gt, ge, make, command line argument count, is command line argument numeric.
         INV arg1, arg2, arg3.
         INV show msg, show msg no newline, show number.

         # The lower and upper bounds of the data array. #
         CONST lwb=1, upb=1_000_000.

         # The actual number of items to sort. Must be less than upb. #
         VAR number to sort.
         CONST default number to sort=10_000.

         CONST max size of list to show=100.

         # The range of random numbers. #
         CONST min random=0, max random=200.

         FUNCTION get data size +size>: 
            make+size+number to sort.
         FUNCTION set number to sort+>number-list size:
            subtract+upb+lwb+list size, incr+list size, min+number+list size+number to sort.         

         FUNCTION process command line -arg count -number:
            set number to sort+default number to sort, command line argument count+arg count,
            (gt+arg count+arg1, is command line argument numeric+arg1+number, set number to sort+number;
             +).
      ENDSEC parametrization.
      PRELUDE process command line.

      SECTION arithmetic.
         ABSTR incr, decr, greater, less, less or equal, le, lt, gt, ge, add, halve, make, make string, random, divide, min, max.
         EXT make, make string, random, incr, less or equal, le, lt, gt, ge, subtract, decr, min, max.

         IMPORT incr, decr, incr with, decr with.
         IMPORT add, subtract, multiply, divide, remainder, modulo, halve.
         IMPORT make, make string, random.
         IMPORT gt, lt, ge, le, eq, ne.
         IMPORT less or equal.

         FUNCTION incr+>a>.
         FUNCTION decr+>a>.
         FUNCTION incr with +>a>+>b.
         FUNCTION decr with +>a>+>b.

         FUNCTION add +>a+>b+c>.
         FUNCTION subtract +>a+>b+c>.
         FUNCTION multiply +>a+>b+c>.
         FUNCTION divide +>a+>b+c>.
         FUNCTION remainder +>a+>b+c>.
         FUNCTION modulo +>a+>b+c>.

         FUNCTION halve +>a>.
         FUNCTION make +a>+>b.
         FUNCTION make string+a>*b.

         TEST gt+>a+>b.
         TEST ne+>a+>b.
         TEST ge+>a+>b.
         TEST le+>a+>b.
         TEST lt+>a+>b.
         TEST eq+>a+>b.

         TEST greater+>a+>b: gt+a+b.         
         TEST less or equal+>a+>b.
         TEST less+>a+>b: lt+a+b.

         FUNCTION min+>a+>b+min>:
            less+a+b, make+min+a;
            make+min+b.

         FUNCTION max+>a+>b+max>:
            less+a+b, make+max+b;
            make+max+a.

         FUNCTION random+>min+>max+r>.
      ENDSEC arithmetic.

      SECTION command line.
         IMPORT command line argument count, is command line argument, is command line argument numeric, get program name.
         ABSTR command line argument count, is command line argument, is command line argument numeric, get program name.
         EXT command line argument count, is command line argument, is command line argument numeric, get program name, arg1, arg2, arg3.

         CONST arg1=0, arg2=1, arg3=2.

         FUNCTION command line argument count+count>.
         TEST is command line argument+>n*arg.
         TEST is command line argument numeric+>n+number>.
         FUNCTION get program name+prog name>.
      ENDSEC command line.

      SECTION touch.
         ABSTR touch in, touch out, touch trans.
         EXT touch in, touch out, touch trans.
         IMPORT touch in, touch out, touch trans.

         FUNCTION touch in+>v.
         FUNCTION touch out+v>.
         FUNCTION touch trans+>v>.
      ENDSEC touch.

      SECTION data.
         ABSTR smaller element, swap element, get element, set element, set element to, dump data, is data sorted macro.
         ABSTR sort data, initialize data, show native sorter, data upb.

         INV show msg, show msg no newline, show number, le, lt, incr, random, make, subtract, decr, max size of list to show.
         INV lwb, upb, get data size, min random, max random.

         IMPORT smaller element, swap element, get element, set element, set element to, is data sorted macro.
         IMPORT sort data, show native sorter.

         # Here for test purposes only. #
         VAR unused.
         ### A variable note.
         NOTE.
         VAR unused2.

         # Imports #
         TEST smaller element +>p+>q.
         ACTION swap element +>i+>j.
         FUNCTION get element +>i+v>.
         ACTION set element +>i+>v.
         ACTION set element to+>p+>q.
         TEST is data sorted macro+>to.
         ACTION sort data+>to.
         ACTION show native sorter.

         FUNCTION data upb+actual upb> -number to sort:
            get data size+number to sort, subtract+number to sort+lwb+actual upb, incr+actual upb.

         ACTION dump list -i-e-upb:
            data upb+upb, make+i+lwb, get element+i+e, show number+e,
              (lt+i+upb, incr+i, show msg no newline+", ",get element+i+e, show number+e, *;
               show msg+"").

         ACTION dump data*msg -data size:
            show msg no newline+msg, get data size+data size,
               (le+data size+max size of list to show, dump list;
                show msg+"too many elements to show.").

         
         # Fill the array with random integers. #
         ACTION initialize data -i -r -upb:
             data upb+upb, make+i+lwb,
              (le+i+upb, random+min random+max random+r, set element+i+r, incr+i, *;
              show msg+"").
      ENDSEC data.

      SECTION timer.
         ABSTR start timer, stop timer, show elapsed time, get elapsed time.
         IMPORT start timer, stop timer, show elapsed time, get elapsed time.

         ACTION start timer.
         ACTION stop timer.
         ACTION show elapsed time.
         FUNCTION get elapsed time+elapsed>.
      ENDSEC timer.

      SECTION messages.
         ABSTR show msg, show msg no newline, show number.
         EXT show msg, show msg no newline, show number.
         IMPORT show msg, show msg no newline, show number.

         ACTION show msg*string.
         ACTION show number +>number.
         ACTION show msg no newline*string.
      ENDSEC messages.
   ENDLAY base.
   ### Note between Layers.
   NOTE.
   LAYER sort.
      SECTION sorter.
         INV lwb, upb, min random, max random.
         INV less, gt, make, add, halve, incr, decr, divide.
         INV swap element, get element, smaller element, dump data, get data size.
         INV show msg, show msg no newline, show number, is data sorted macro, less or equal.
         INV start timer, stop timer, show elapsed time, get elapsed time.
         INV touch in, touch out.
         INV initialize data, sort data, show native sorter, data upb.

         ACTION quicksort +>from +>to -p -q:
            less + from + to, split + from + to + p + q, quicksort + from + q, quicksort + p + to;
            +.

         # Split the array into two parts. #
         # The first part contains elements less than or equal to the pivot. #
         ACTION split +>i +>j +p> +q> - m:
            make + p + i, make + q + j, add + i + j + m, halve + m,
            (again:
               ### Notes can be placed almost anywhere. Note that ther is no period at the end.
               NOTE
               move p up + j + p + m, move q down + i + q + m,
               (less + p + q, swap element + p + q, incr + p, decr + q, * again;
               less + p + m, swap element + p + m, incr + p;
               less + m + q, swap element + q + m, decr + q;
               +)
            ).

         FUNCTION move p up+>j+>p>+>m:
            less+j+p;
            smaller element+m+p;
            incr+p, *.

         FUNCTION move q down+>i+>q>+>m:
            less+q+i;
            smaller element+q+m;
            decr+q, *.

         TEST is data unsorted procedure+unsorted at>  -i -j -ei -ej -upb:
            make+i+lwb, make+j+i, incr+j, data upb+upb,
               (next: less+i+upb, get element+i+ei, get element+j+ej,
                  (less or equal+ei+ej, incr+i, incr+j, *next;
                   make+unsorted at+i
                  )
               ).  
                
         TEST use macro for sortedness test: +.

         PREDICATE is data sorted +>to:
            use macro for sortedness test, is data sorted macro+to;
            show unsorted with location.

         PREDICATE show unsorted with location -pos:
            is data unsorted procedure+pos, show msg no newline+"Unsorted at ", show number+pos, show msg+".", -;
            +.

         ACTION verify data sorted * which +>to:
            is data sorted+to, show msg no newline+which, show msg+" data is sorted.";
            show msg no newline+which, show msg+" data is not sorted.".

         CONST zero = 0.
         ACTION run demo -data size -cdl2 elapsed -builtin elapsed -ratio -to:
            data upb+to, initialize data,
            dump data+"Data before sorting: ", verify data sorted+"Random"+to,

            get data size+data size,
            show msg no new line+"Running quicksort on list of ", show number+data size, 
            show msg no newline+" random elements between ", show number+min random, show msg no new line+" and ",
            show number+max random, show msg+".",
            start timer, quicksort+lwb+to, stop timer, get elapsed time+cdl2 elapsed, show elapsed time,
            dump data+"Data after sorting: ", verify data sorted+"Quicksort-ed"+to,

            initialize data,
            show msg no newline +"Running native (", show native sorter, show msg+") sort on list.",
            start timer, sort data+to, stop timer, get elapsed time+builtin elapsed, show elapsed time,
            (gt+builtin elapsed+zero, divide+cdl2 elapsed+builtin elapsed+ratio, 
               show msg no newline+"Ratio: ", show number+ratio, show msg+".";
             +).
         
         # Test builtin function.
         ACTION show user and code generation date -gen date -gen time -user:
            BUILTIN date+gen date, BUILTIN time+gen time,
              show msg no newline+"Code generated on ", show msg no newline+gen date, show msg no newline+" at ", show msg+gen time,
            BUILTIN environment variable+"USERNAME"+user, show msg no newline+"User: ", show msg+user.
         
         # Test conditional compilation with built-in tests.
         ACTION show cg options:
            show target, show proc inlining, show macro inlining, show msg+".".
         ACTION show target:
            BUILTIN is target+"PowerShell", show msg no newline+"Target: PowerShell";
            BUILTIN is target+"CSharp", show msg no newline+"Target: C#";
            BUILTIN is target+"C", show msg no newline+"Target: C";
            show msg+"Target: unknown".
         ACTION show proc inlining:
            BUILTIN is option+"NoProcInlining", show msg no newline+", NoProcInlining";
            show msg no newline+", ProcInlining".
         ACTION show macro inlining:
            BUILTIN is option+"NoMacroInlining", show msg no newline+", NoMacroInlining";
            show msg no newline+", MacroInlining".
      ENDSEC sorter.
      PRELUDE show user and code generation date, show cg options.
      ROOT run demo.
   ENDLAY sort.
ENDMOD quicksort.
PRELUDE parametrization, sorter.
ROOT sorter.

#PRAGMA Target=PowerShell file=psort#
PROGRAM powershell sort.
   PART powershell kernel, quicksort.
   PRELUDE quicksort.
   ROOT quicksort.
ENDPROG powershell sort.

#PRAGMA Target=CSharp file=cssort#
PROGRAM csharp sort.
   PART csharp kernel, quicksort.
   PRELUDE quicksort.
   ROOT quicksort.
ENDPROG csharp sort.

#PRAGMA Target=C file=csort tracestack=100000#
PROGRAM c sort.
   PART c kernel, quicksort.
   PRELUDE quicksort.
   ROOT quicksort.

ENDPROG c sort.

#PRAGMA Target=C file=memtest#
PROGRAM memory test.
   PART c kernel, dynamic data, dyn memory test.
   PRELUDE dynamic data, dyn memory test.
   ROOT dyn memory test.
   POSTLUDE dynamic data.
ENDPROG memory test.