# Ignore Spelling: lwb upb eq ne ge namespace str concat io fac prog decr cspell
# Ignore Spelling: ENDMOD ENDLAY ENDSEC quicksort incr msg 
# cspell:ignore ENDMOD ENDLAY ENDSEC decr ABSTR

MODULE quicksort.
   LAYER base.
      SECTION arithmetic.
         ABSTR incr, decr, greater, less, less or equal,add, halve, make, random.
         EXT make, random, incr, less or equal.

         FUNCTION incr+>a> = a "++".
         FUNCTION decr+>a> = a "--".
         TEST greater+>a+>b = a " -gt " b.
         TEST less+>a+>b = a " -lt " b.
         TEST less or equal+>a+>b = a " -le " b.
         FUNCTION add +>a+>b+c> = c " = " a " + " b.
         FUNCTION halve +>a> = a " /= 2".
         FUNCTION make +a>+>b = a " = " b.

         CONST min random=0, max random=200.
         FUNCTION random+>min+>max+r> =: r " = Get-Random -Minimum " min " -Maximum (" max " + 1)".
      ENDSEC arithmetic.
      SECTION data.
         ABSTR lwb, upb, smaller element, swap element, get element, set element, dump data.
         INV make, less or equal, random, incr, show msg no newline.

         # The lower and upper bounds of the array. #
         CONST lwb=0, upb=100.

         # The array to be sorted. #
         LIST data(lwb:upb).

         # Here for test purposes only. #
         VAR unused.

         TEST smaller element +>p+>q =: 
            data ".Item(" p ") -lt " data ".Item(" q ")".
         ACTION swap element +>p+>q -t:
            get element+p+t, set element to+p+q, set element+q+t.
         FUNCTION get element +>i+v> =: 
            v " = " data ".Item(" i ")".
         ACTION set element +>i+>v =: 
            data ".Item(" i "," v ")".
         ACTION set element to+>p+>q =
            data ".Item(" p "," data ".Item(" q "))".

         ACTION dump list = 
            "Write-Host " data.
         ACTION dump data*msg:
            show msg no newline+msg, dump list.
         # The range of random numbers. #
         CONST min random=0, max random=200.
         # Fill the array with random integers. #
         ACTION initialize data -i -r:
            make+i+lwb,
            (less or equal+i+upb, random+min random+max random+r, set element+i+r, incr+i, *;
            +).
      ENDSEC data.
      PRELUDE initialize data.
      SECTION messages.
         ABSTR show msg, show msg no newline.
         EXT show msg, show msg no newline.

         ACTION show msg*string = "Write-Host " string.
         ACTION show msg no newline*string = "Write-Host -NoNewline" string.
      ENDSEC messages.
   ENDLAY base.
   LAYER sort.
      SECTION sorter.
         INV lwb, upb, less, make, add, halve, incr, decr, swap element, smaller element, dump data.
         ACTION quicksort +>from +>to -p -q:
            less + from + to, split + from + to + p + q, quicksort + from + q, quicksort + p + to;
            +.
         # Split the array into two parts. #
         # The first part contains elements less than or equal to the pivot. #
         ACTION split+>i+>j+p>+q> - m:
            make + p + i, make + q + j, add + i + j + m, halve + m,
            (again: move p up + j + p + m, move q down + i + q + m,
               (less + p + q, swap element + p + q, incr + p, decr + q, * again;
               less + p + m, swap element + p + m, incr + p;
               less + m + q, swap element + q + m, decr + q;
               +)
            ).

         FUNCTION move p up+>j+>p>+>m:
            less+p+j;
            smaller element+m+p;
            incr+p, *.

         FUNCTION move q down+>i+>q>+>m:
            less+q+i;
            smaller element+q+m;
            decr+q, *.
      ENDSEC sorter.
      ROOT dump data+"Data before sorting: ", quicksort+lwb+upb, dump data+"Data after sorting: ".
   ENDLAY sort.
ENDMOD quicksort.
PRELUDE data.
ROOT sorter.
PROGRAM sort.
   PART quicksort.
   PRELUDE quicksort.
   ROOT quicksort.
ENDPROG sort.












