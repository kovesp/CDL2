# Ignore Spelling: lwb upb eq ne ge namespace str concat io fac prog decr cspell
# Ignore Spelling: ENDMOD ENDLAY ENDSEC quicksort incr msg 
# cspell:ignore ENDMOD ENDLAY ENDSEC ENDPROG decr ABSTR incr decr

MODULE quicksort.
   LAYER base.
      SECTION parametrization.
         ABSTR lwb, upb.
         EXT lwb, upb, max size of list to show, min random, max random.

         # The lower and upper bounds of the data array. #
         CONST lwb=1, upb=1_000.
         CONST max size of list to show=100.

         # The range of random numbers. #
         CONST min random=0, max random=200.
      ENDSEC parametrization.
      SECTION arithmetic.
         ABSTR incr, decr, greater, less, less or equal, add, halve, make, random.
         EXT make, random, incr, less or equal, subtract.

         TEST choose +>a+>limit+c>+>inc =
            "$L" c " = " a " + " inc
            "$L" a " -gt " limit.
         # Return the test result as 0 or 1
         FUNCTION choose func +>a+>limit+c>+>inc+res> =
            c " = " a " + " inc
            "$L" res " = [int](" a " -gt " limit ")".

         FUNCTION incr+>a> = a "++".
         FUNCTION decr+>a> = a "--".
         FUNCTION incr with +>a>+>b = a " += " b.
         FUNCTION decr with +>a>+>b = a " -= " b.

         FUNCTION add +>a+>b+c> = c " = " a " + " b.
         FUNCTION subtract +>a+>b+c> = c " = " a " - " b.
         FUNCTION multiply +>a+>b+c> = c " = " a " * " b.
         FUNCTION divide +>a+>b+c> = c " = " a " / " b.
         FUNCTION remainder +>a+>b+c> = c " = " a " - " a " / " b " * " b.
         FUNCTION modulo +>a+>b+c> = c " = " a " % " b.

         FUNCTION halve +>a> = a " /= 2".
         FUNCTION make +a>+>b = a " = " b.

         ACTION action test: +.

         ### A constant note.
         NOTE.
         CONST ten=10.
         VAR var.

         # Test of builtin parsing.
         FUNCTION parse prolog:
            BUILTIN is option value+"Prolog Syntax"+"MProlog", parse mprolog;
            BUILTIN is option value+"Prolog Syntax"+"SWI", parse swiprolog;
            +.

         ### Procedures for testing the Semantic analyzer
         # Conditional compilation flag.
         TEST wants less test: -.
         # This proc cannot fail.          
         TEST test+>a+>b>+c>:
            wants less test, less+a+b, make+c+a;
            eq+a+b, add+a+ten+c,action test;
            add+b+ten+var, incr+b, make+c+b.
         # This proc tries to use a fail.
         FUNCTION illegal fail operator: eq+var+ten, -.

         TEST lt+>a+>b = a " -lt " b.
         TEST eq+>a+>b = a " -eq " b.

         TEST gt+>a+>b : lt+b+a.
         TEST ne+>a+>b : eq+a+b,- ; +.
         TEST ge+>a+>b : eq+a+b ; gt+a+b.
         TEST le+>a+>b : eq+a+b ; lt+a+b. 
         TEST greater+>a+>b : gt+a+b.
         TEST less+>a+>b : lt+a+b.
         TEST less or equal+>a+>b : le+a+b.

         FUNCTION random+>min+>max+r> = r " = Get-Random -Minimum " min " -Maximum (" max " + 1)".
      ENDSEC arithmetic.
      SECTION data.
         ABSTR smaller element, swap element, get element, set element, dump data, is data sorted macro, get data size.
         INV lwb, upb, make, less or equal, random, incr, subtract, show msg, show msg no newline, max size of list to show,
             min random, max random.

         # The array to be sorted. #
         LIST data(lwb:upb).

         # Here for test purposes only. #
         VAR unused.
         ### A variable note.
         NOTE.
         VAR unused2.

         TEST smaller element +>p+>q = 
            data ".Item(" p ") -lt " data ".Item(" q ")".
         ACTION swap element +>p+>q -t:
            get element+p+t, set element to+p+q, set element+q+t.
         FUNCTION get element +>i+v> = 
            v " = " data ".Item(" i ")".
         ACTION set element +>i+>v = 
            data ".Item(" i "," v ")".
         ACTION set element to+>p+>q =
            data ".Item(" p "," data ".Item(" q "))".

         ACTION dump list = 
            "Write-Host " data ".Array".

         ACTION dump data*msg:
            show msg no newline+msg,
               (less or equal+data size+max size of list to show, dump list;
                show msg+"too many elements to show.").

         TEST is data sorted macro -i -r =
            "$l " r " = 1"
            "$l for (" i " = " lwb " ; " i " -lt " upb " ; " i "++) {"
            "$l    if (" data ".Item(" i ") -gt " data ".Item(" i " + 1)) { " r " = 0; break }"
            "$l }"
            "$l [bool]" r.

         # The size of the list to be sorted as a variable. Just to excercise VARs.
         VAR data size.

         # The size of the list to be sorted. VARs cannot be EXTended or ABSTRacted. 
         FUNCTION get data size +size>: make+size+data size.

         # Fill the array with random integers. #
         ACTION initialize data -i -r:
            subtract+upb+lwb+data size, incr+data size,
            make+i+lwb,
            (less or equal+i+upb, random+min random+max random+r, set element+i+r, incr+i, *;
            +).
      ENDSEC data.
      PRELUDE initialize data.
      SECTION timer.
         ABSTR start timer, stop timer, show elapsed time.

         ACTION start timer = "$l $$script:start = Get-Date".
         ACTION stop timer  = "$l $$script:stop = Get-Date".
         ACTION show elapsed time = 
            "$l Write-Host -ForegroundColor Blue ('Elapsed time: {0:N0} miliseconds' -f [int](($$script:stop-$$script:start).TotalMicroseconds/1000))".
      ENDSEC timer.
      SECTION messages.
         ABSTR show msg, show msg no newline, show number.
         EXT show msg, show msg no newline, show number.

         ACTION show msg*string = "Write-Host " string.
         ACTION show number +>number = "Write-Host -NoNewline ('{0:N0}' -f " number ")".
         ACTION show msg no newline*string = "Write-Host -NoNewline " string.
      ENDSEC messages.
   ENDLAY base.
   ### Note between Layers.
   NOTE.
   LAYER sort.
      SECTION sorter.
         INV lwb, upb, less, make, add, halve, incr, decr, swap element, get element, smaller element, dump data, get data size,
            show msg, show msg no newline, show number, is data sorted macro, less or equal, start timer, stop timer, show elapsed time.

         ACTION quicksort +>from +>to -p -q:
            less + from + to, split + from + to + p + q, quicksort + from + q, quicksort + p + to;
            +.

         # Split the array into two parts. #
         # The first part contains elements less than or equal to the pivot. #
         ACTION split +>i +>j +p> +q> - m:
            make + p + i, make + q + j, add + i + j + m, halve + m,
            (again:
               ### Notes can be placed almost anywhere.
               NOTE.
               move p up + j + p + m, move q down + i + q + m,
               (less + p + q, swap element + p + q, incr + p, decr + q, * again;
               less + p + m, swap element + p + m, incr + p;
               less + m + q, swap element + q + m, decr + q;
               +)
            ).

         FUNCTION move p up+>j+>p>+>m:
            less+j+p;
            smaller element+m+p;
            incr+p, *.

         FUNCTION move q down+>i+>q>+>m:
            less+q+i;
            smaller element+q+m;
            decr+q, *.

         TEST is data unsorted procedure +unsorted at>  -i -j -ei -ej:
            make+i+lwb, make+j+i, incr+j,
               (next: less+i+upb, get element+i+ei, get element+j+ej,
                  (less or equal+ei+ej, incr+i, incr+j, *next;
                   make+unsorted at+i
                  )
               ).  
                
         TEST use macro for sortedness test: -.

         PREDICATE is data sorted -where:
            use macro for sortedness test, is data sorted macro;
            is data unsorted procedure+where, show msg no newline+"Unsorted at ", show number+where, show msg+".", -;
            +.

         ACTION verify data sorted * which:
            is data sorted, show msg no newline+which, show msg+" data is sorted.";
            show msg no newline+which, show msg+" data is not sorted.".

         ACTION run demo -data size:
            get data size+data size,
            show msg no new line+"Running quicksort on list of ", show number+data size, show msg+" elements.",
            start timer, quicksort+lwb+upb, stop timer,
            show elapsed time.

      ENDSEC sorter.
      PRELUDE dump data+"Data before sorting: ", verify data sorted+"Random".
      ROOT run demo.
      POSTLUDE dump data+"Data after sorting: ", verify data sorted+"Quicksorted".
   ENDLAY sort.
ENDMOD quicksort.
PRELUDE data, sorter.
ROOT sorter.
POSTLUDE sorter.
PROGRAM sort.
   PART quicksort.
   PRELUDE quicksort.
   ROOT quicksort.
   POSTLUDE quicksort.
ENDPROG sort.
