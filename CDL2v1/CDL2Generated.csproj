<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <!-- Only build for DebugGenerated and ReleaseGenerated configurations -->
  <PropertyGroup Condition="'$(Configuration)'!='DebugGenerated' And '$(Configuration)'!='ReleaseGenerated'">
    <ExcludeFromBuild>true</ExcludeFromBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include only .cs files from the CDL2 directory -->
    <Compile Include="CDL2\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude all other .cs files from the project root and subdirectories -->
    <Compile Remove="*.cs" />
    <Compile Remove="**\*.cs" Exclude="CDL2\**\*.cs" />
  </ItemGroup>

</Project>